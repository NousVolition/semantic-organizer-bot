<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="https://example.org/concepts">
  <owl:Ontology rdf:about="https://example.org/concepts"/>
  <owl:Class rdf:about="#Pattern">
    <owl:disjointWith rdf:resource="#NonPattern"/>
  </owl:Class>
  <owl:Class rdf:about="#NonPattern"/>
  <owl:NamedIndividual rdf:about="#example">
    <rdf:type rdf:resource="#Pattern"/>
    <rdf:type rdf:resource="#NonPattern"/>
  </owl:NamedIndividual>
</rdf:RDF>
