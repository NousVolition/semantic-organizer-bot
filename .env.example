# Copy to .env and fill in after registering the GitHub App
APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=
# Paste the entire GitHub App RSA private key into PRIVATE_KEY, or use:
# PRIVATE_KEY_PATH=./private-key.pem
# For .env only, wrap multiline PEM text in double quotes; literal \n also works.

# Required for semantic suggestions
OPENAI_API_KEY=
# Optional: model to use (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: create semantic-note issues after pushes to the default branch.
# Off by default; normal issue and PR reviews do not need this setting.
# ENABLE_PUSH_REVIEWS=true
