# Copy to .env and fill in after registering the GitHub App
APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=
# Recovery encryption defaults to WEBHOOK_SECRET (at least 16 characters).
# Keep the chosen secret stable/backed up. Changing it makes saved state unreadable.
# Set a separate secret here only to rotate the webhook secret independently:
# DISCOVERY_STATE_SECRET=
# Automatic recovery of registered interrupted jobs is on by default.
# Set false to retain manual-only recovery:
# DISCOVERY_AUTO_RESUME=false
# Paste the entire GitHub App RSA private key into PRIVATE_KEY, or use:
# PRIVATE_KEY_PATH=./private-key.pem
# For .env only, wrap multiline PEM text in double quotes; literal \n also works.

# Required for semantic suggestions
OPENAI_API_KEY=
# Optional: model to use (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Discovery uses gpt-5.4-mini unless DISCOVERY_MODEL or OPENAI_MODEL is set.
# DISCOVERY_MODEL=gpt-5.4-mini

# Optional: comment on new issues and opened/edited/synchronized PR text.
# Off by default: discovery mode reads source documents when requested.
# ENABLE_TEXT_REVIEWS=true

# Optional: create semantic-note issues after pushes to the default branch.
# Off by default; normal issue and PR reviews do not need this setting.
# ENABLE_PUSH_REVIEWS=true

# Optional: use a local Hugging Face embedding model to shortlist cross-file
# passages for a normal [Discover language] run. Off by default. The shortlist
# is only a heuristic; existing citation and comparison checks still decide what
# can be published. The first enabled run downloads the public model.
# ENABLE_DRIFT_SCAN=true
